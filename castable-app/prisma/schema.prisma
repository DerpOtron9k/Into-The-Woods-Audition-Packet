// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Clerk User ID Table
// This table is used to create a relationship between our database
// and Clerk's user management system.
model User {
  id        String  @id @unique
  email     String  @unique
  shows     Show[]
  templates ShowTemplate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Show {
  id              String      @id @default(cuid())
  title           String
  description     String?
  director        String
  organization    String?
  auditionDate    DateTime?
  deadline        DateTime?
  location        String?
  contactEmail    String
  contactPhone    String?
  status          String      @default("draft") // draft, active, closed
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  characters      Character[]
  applicants      Applicant[]
  auditionMaterials AuditionMaterial[]
  events          ShowEvent[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // New fields for rich audition packet
  greetingMessage   String?
  auditionPrepRequirements String?
  rehearsalInfo     String?
  castingInfo       String?
  musicDirector     String?
  choreographer     String?
  venue             String?
  rehearsalPeriod   String?
}

model Character {
  id          String  @id @default(cuid())
  name        String
  description String?
  gender      String  @default("Any") // Male, Female, Any
  ageRange    String?
  notes       String?
  showId      String
  show        Show    @relation(fields: [showId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // New fields for detailed character info
  category      String? // e.g., "Principal", "Supporting", "Cameo"
  vocalInfo     String? // Replaces vocalRange for more descriptive text
  auditionCut   String? // e.g., "No More, m.79-109"
  auditionMaterials AuditionMaterial[]
}

model AuditionMaterial {
  id          String   @id @default(cuid())
  type        String   // script, music, video, other
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  showId      String
  show        Show     @relation(fields: [showId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // New field to link to a specific character
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id])
}

model Applicant {
  id              String    @id @default(cuid())
  name            String
  email           String
  phone           String?
  headshotUrl     String?
  resumeUrl       String?
  auditionFileUrl String?
  selectedRoles   String[]  @default([])
  experience      String?
  availability    String?
  additionalNotes String?
  showId          String
  show            Show      @relation(fields: [showId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum ShowEventType {
  AUDITION
  CALLBACK
  PERFORMANCE
  REHEARSAL
  INFO
}

model ShowEvent {
  id        String        @id @default(cuid())
  showId    String
  show      Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  type      ShowEventType
  startAt   DateTime
  endAt     DateTime?
  timezone  String?
  location  String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([showId, type, startAt])
}

model ShowTemplate {
  id              String      @id @default(cuid())
  name            String      // Template name (e.g., "Musical Template", "Drama Template")
  description     String?     // Template description
  title           String?     // Default show title (can be overridden)
  showDescription String?     // Default show description
  director        String?     // Default director name
  organization    String?     // Default organization
  location        String?     // Default location
  contactEmail    String?     // Default contact email
  contactPhone    String?     // Default contact phone
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  characters      TemplateCharacter[]
  auditionMaterials TemplateAuditionMaterial[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model TemplateCharacter {
  id          String       @id @default(cuid())
  name        String
  description String?
  gender      String       @default("Any") // Male, Female, Any
  ageRange    String?
  vocalRange  String?
  notes       String?
  templateId  String
  template    ShowTemplate @relation(fields: [templateId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TemplateAuditionMaterial {
  id          String       @id @default(cuid())
  type        String       // script, music, video, other
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  templateId  String
  template    ShowTemplate @relation(fields: [templateId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
