{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "ruffin/intothewoods/index.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/ruffin/intothewoods",
      "destination": "/ruffin/intothewoods/"
    },
    {
      "source": "/ruffin/intothewoods/",
      "destination": "/ruffin/intothewoods/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
